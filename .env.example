# Required: Claude API key from https://platform.claude.com (powers mood queues and live charts)
ANTHROPIC_API_KEY=

# Optional: YouTube Data API v3 key from https://console.cloud.google.com (enables the autoplaying in-app player)
YOUTUBE_API_KEY=

# Optional: override the Claude model (default: claude-sonnet-5-5)
CLAUDE_MODEL=

# Optional: require a passcode to build queues, so strangers can't spend your API credits
APP_PASSCODE=
