# Required: free Gemini API key from https://aistudio.google.com/apikey (powers mood queues and "Just dropped")
GEMINI_API_KEY=

# Optional: YouTube Data API v3 key from https://console.cloud.google.com (free; enables the autoplaying in-app player)
YOUTUBE_API_KEY=

# Optional: which Apple Music country chart to show (two-letter code, e.g. us, gb, ae). Default: us
CHART_COUNTRY=

# Optional: override models (defaults: gemini-3.5-flash for picks, gemini-2.5-flash for search-grounded new releases)
GEMINI_MODEL=
GEMINI_SEARCH_MODEL=

# Optional: require a passcode to build queues, so strangers can't use up your free quota
APP_PASSCODE=
